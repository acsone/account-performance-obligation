<odoo>
    <record id="view_perf_obligation_obs_adjust_wizard" model="ir.ui.view">
        <field name="name">perf.obligation.obs.adjust.wizard.form</field>
        <field name="model">perf.obligation.obs.adjust.wizard</field>
        <field name="arch" type="xml">
            <form string="Adjust Off-Balance Sheet Commitments">
                <group>
                    <field name="date" />
                </group>
                <footer>
                    <button
                        name="action_adjust"
                        type="object"
                        string="Adjust"
                        class="btn-primary"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_perf_obligation_obs_adjust_wizard" model="ir.actions.act_window">
        <field name="name">Adjust Off-Balance Sheet Commitments</field>
        <field name="res_model">perf.obligation.obs.adjust.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record
        id="action_perf_obligation_obs_adjust_wizard_selection"
        model="ir.actions.server"
    >
        <field name="name">Adjust Off-Balance Sheet Commitments</field>
        <field name="model_id" ref="account_perf_obligation.model_perf_obligation" />
        <field
            name="binding_model_id"
            ref="account_perf_obligation.model_perf_obligation"
        />
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field
            name="code"
        >action = env.ref('account_perf_obligation_obs.action_perf_obligation_obs_adjust_wizard').read()[0]
action['context'] = {'active_ids': env.context.get('active_ids', [])}</field>
    </record>

    <menuitem
        id="menu_perf_obligation_obs_adjust"
        name="Adjust Off-Balance Sheet Commitments"
        action="action_perf_obligation_obs_adjust_wizard"
        parent="account.menu_finance_entries"
        sequence="16"
    />
</odoo>
