<odoo>
    <record id="res_config_settings_view_form_perf_obligation_obs" model="ir.ui.view">
        <field name="name">
            res.config.settings.form.perf.obligation.obs
        </field>
        <field name="model">res.config.settings</field>
        <field
            name="inherit_id"
            ref="account_perf_obligation.res_config_settings_view_form_perf_obligation"
        />
        <field name="arch" type="xml">
            <xpath
                expr="//block[@id='perf_obligation_settings']/setting[last()]"
                position="after"
            >
                <setting
                    string="Off-Balance Sheet Commitments"
                    help="Configure the journal and accounts used to record
                          off-balance sheet commitments linked to performance
                          obligations."
                >
                    <div class="content-group">
                        <div class="row mt-2">
                            <label
                                for="po_obs_journal_id"
                                class="col-lg-4 o_light_label"
                                string="Off-Balance Sheet Journal"
                            />
                            <field
                                name="po_obs_journal_id"
                                domain="[('type', '=', 'general')]"
                                context="{'default_type': 'general'}"
                            />
                        </div>
                        <div class="row">
                            <label
                                for="po_obs_income_account_id"
                                class="col-lg-4 o_light_label"
                                string="OBS Income Account"
                            />
                            <field
                                name="po_obs_income_account_id"
                                domain="[('account_type', '=', 'off_balance'), ('deprecated', '=', False)]"
                                context="{'default_account_type': 'off_balance'}"
                            />
                        </div>
                        <div class="row">
                            <label
                                for="po_obs_expense_account_id"
                                class="col-lg-4 o_light_label"
                                string="OBS Expense Account"
                            />
                            <field
                                name="po_obs_expense_account_id"
                                domain="[('account_type', '=', 'off_balance'), ('deprecated', '=', False)]"
                                context="{'default_account_type': 'off_balance'}"
                            />
                        </div>
                        <div class="row">
                            <label
                                for="po_obs_counterpart_account_id"
                                class="col-lg-4 o_light_label"
                                string="OBS Counterpart Account"
                            />
                            <field
                                name="po_obs_counterpart_account_id"
                                domain="[('account_type', '=', 'off_balance'), ('deprecated', '=', False)]"
                                context="{'default_account_type': 'off_balance'}"
                            />
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
