<odoo>
    <record id="view_move_form_perf_obligation" model="ir.ui.view">
        <field name="name">account.move.form.perf.obligation</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='invoice_line_ids']//field[@name='account_id']"
                position="after"
            >
                <field
                    name="perf_obligation_id"
                    optional="hide"
                    options="{'no_create': True}"
                />
            </xpath>
            <xpath
                expr="//field[@name='line_ids']//field[@name='account_id']"
                position="after"
            >
                <field
                    name="perf_obligation_id"
                    optional="hide"
                    options="{'no_create': True}"
                />
            </xpath>
        </field>
    </record>

    <record id="account_move_line_tree_view" model="ir.ui.view">
        <field name="name">account.move.line.list.perf.obligation</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='balance']" position="after">
                <field
                    name="perf_obligation_id"
                    optional="hide"
                    options="{'no_create': True}"
                />
            </xpath>
        </field>
    </record>

    <record id="account_move_line_form_view" model="ir.ui.view">
        <field name="name">account.move.line.form.perf.obligation</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='account_id']" position="after">
                <field name="perf_obligation_id" options="{'no_create': True}" />
            </xpath>
        </field>
    </record>
</odoo>
