<odoo>
    <record id="perf_obligation_view_list_not_in_service" model="ir.ui.view">
        <field name="name">perf.obligation.list.not.in.service</field>
        <field name="model">perf.obligation</field>
        <field name="inherit_id" ref="account_perf_obligation.perf_obligation_tree" />
        <field name="arch" type="xml">
            <field name="state" position="after">
                <field name="not_in_service" optional="show" />
            </field>
        </field>
    </record>

    <record id="perf_obligation_view_form_not_in_service" model="ir.ui.view">
        <field name="name">perf.obligation.form.not.in.service</field>
        <field name="model">perf.obligation</field>
        <field name="inherit_id" ref="account_perf_obligation.perf_obligation_form" />
        <field name="arch" type="xml">
            <field name="perf_type" position="before">
                <field name="not_in_service" readonly="state == 'done'" />
            </field>
        </field>
    </record>

    <record id="perf_obligation_view_search_not_in_service" model="ir.ui.view">
        <field name="name">perf.obligation.search.not.in.service</field>
        <field name="model">perf.obligation</field>
        <field name="inherit_id" ref="account_perf_obligation.perf_obligation_search" />
        <field name="arch" type="xml">
            <filter name="done" position="after">
                <filter
                    name="not_in_service"
                    string="Not in Service"
                    domain="[('not_in_service', '=', True)]"
                />
            </filter>
        </field>
    </record>
</odoo>
