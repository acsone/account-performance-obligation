<odoo>
    <record id="view_contract_form_perf_obligation" model="ir.ui.view">
        <field name="name">contract.contract.form.perf.obligation</field>
        <field name="model">contract.contract</field>
        <field name="inherit_id" ref="contract.contract_contract_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_perf_obligations"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-balance-scale"
                    invisible="perf_obligation_count == 0"
                    groups="account.group_account_user"
                >
                    <field
                        name="perf_obligation_count"
                        widget="statinfo"
                        string="Performance Obligations"
                    />
                </button>
            </xpath>
        </field>
    </record>
</odoo>
