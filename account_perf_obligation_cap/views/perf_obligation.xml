<odoo>
    <record id="perf_obligation_form_inherit_cap" model="ir.ui.view">
        <field name="name">perf.obligation.form.inherit.cap</field>
        <field name="model">perf.obligation</field>
        <field name="inherit_id" ref="account_perf_obligation.perf_obligation_form" />
        <field name="arch" type="xml">
            <field name="total_amount" position="after">
                <field name="recognition_cap_enabled" />
                <field
                    name="recognition_cap_amount"
                    invisible="not recognition_cap_enabled"
                />
            </field>
        </field>
    </record>
    <record id="perf_obligation_search_inherit_cap" model="ir.ui.view">
        <field name="name">perf.obligation.search.inherit.cap</field>
        <field name="model">perf.obligation</field>
        <field name="inherit_id" ref="account_perf_obligation.perf_obligation_search" />
        <field name="arch" type="xml">
            <filter name="needs_regeneration" position="before">
                <filter
                    name="capped"
                    string="Capped"
                    domain="[('recognition_cap_enabled', '=', True)]"
                />
            </filter>
        </field>
    </record>
</odoo>
