#. module: account_perf_obligation_cap
#: model_terms:ir.ui.view,arch_db:account_perf_obligation_cap.perf_obligation_search_inherit_cap
msgid "Capped"
msgstr "Plafonné"

#. module: account_perf_obligation_cap
#: model:ir.model.fields,field_description:account_perf_obligation_cap.field_perf_obligation__recognition_cap_enabled
msgid "Limit Maximum Amount to Recognize"
msgstr "Limiter le montant maximum à reconnaître"

#. module: account_perf_obligation_cap
#: model:ir.model.fields,field_description:account_perf_obligation_cap.field_perf_obligation__recognition_cap_amount
msgid "Maximum Amount Allowed for Recognition"
msgstr "Montant maximum autorisé pour la reconnaissance"

#. module: account_perf_obligation_cap
#: model:ir.model.fields,help:account_perf_obligation_cap.field_perf_obligation__recognition_cap_amount
msgid ""
"Maximum cumulative amount that can be recognized for this obligation. Must "
"have the same sign as the total amount and its absolute value cannot exceed "
"that of the total amount."
msgstr ""
"Montant cumulé maximal pouvant être reconnu sur cette obligation. Ce montant "
"doit être de même signe que le montant total et sa valeur absolue ne peut "
"excéder celle de ce dernier."

#. module: account_perf_obligation_cap
#: model:ir.model,name:account_perf_obligation_cap.model_perf_obligation
msgid "Performance Obligation"
msgstr "Obligation de performance"

#. module: account_perf_obligation_cap
#. odoo-python
#: code:addons/account_perf_obligation_cap/models/perf_obligation.py:0
msgid ""
"The amount to recognize (%(amount)s) cannot exceed the recognition cap "
"(%(cap)s) on performance obligation %(name)s."
msgstr ""
"Le montant à reconnaître (%(amount)s) ne peut pas dépasser le plafond de "
"reconnaissance (%(cap)s) sur l'obligation de performance %(name)s."

#. module: account_perf_obligation_cap
#. odoo-python
#: code:addons/account_perf_obligation_cap/models/perf_obligation.py:0
msgid ""
"The recognition cap (%(cap)s) cannot exceed the total amount (%(total)s) on "
"performance obligation %(name)s."
msgstr ""
"Le plafond de reconnaissance (%(cap)s) ne peut pas dépasser le montant total "
"(%(total)s) de l'obligation de performance %(name)s."

#. module: account_perf_obligation_cap
#. odoo-python
#: code:addons/account_perf_obligation_cap/models/perf_obligation.py:0
msgid ""
"The recognition cap must have the same sign as the total amount on "
"performance obligation %(name)s."
msgstr ""
"Le plafond de reconnaissance doit avoir le même signe que le montant total "
"des obligations de performance %(nom)."

#. module: account_perf_obligation_cap
#: model:ir.model.fields,help:account_perf_obligation_cap.field_perf_obligation__recognition_cap_enabled
msgid ""
"When enabled, the recognized amount on this obligation will never exceed the"
" configured cap (in absolute terms), even if the recognition method or "
"linked invoices/bills would otherwise recognize more."
msgstr ""
"Lorsqu'elle est activée, le montant reconnu de cette obligation ne dépassera "
"jamais le plafond configuré (en valeur absolue), même si la méthode de "
"reconnaissance ou les factures/notes de frais liées reconnaîtraient "
"autrement un montant supérieur."
