<odoo>
    <record id="perf_obligation_form_inherit_delivered" model="ir.ui.view">
        <field name="name">perf.obligation.form.inherit.delivered</field>
        <field name="model">perf.obligation</field>
        <field name="inherit_id" ref="account_perf_obligation.perf_obligation_form" />
        <field name="arch" type="xml">
            <field name="end_date" position="after">
                <field
                    name="delivered_amount"
                    invisible="recognition_at_date_method != 'delivered'"
                />
                <field
                    name="recognition_lock_date"
                    invisible="recognition_at_date_method != 'delivered'"
                    readonly="1"
                />
            </field>
        </field>
    </record>

    <record id="perf_obligation_tree_inherit_delivered" model="ir.ui.view">
        <field name="name">perf.obligation.list.inherit.delivered</field>
        <field name="model">perf.obligation</field>
        <field name="inherit_id" ref="account_perf_obligation.perf_obligation_tree" />
        <field name="arch" type="xml">
            <field name="total_amount" position="after">
                <field name="delivered_amount" optional="hide" />
                <field name="recognition_lock_date" optional="hide" />
            </field>
        </field>
    </record>
</odoo>
