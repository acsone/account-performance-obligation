<odoo>
    <record id="view_order_form_perf_obligation" model="ir.ui.view">
        <field name="name">sale.order.form.perf.obligation</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_perf_obligations"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-balance-scale"
                    invisible="perf_obligation_count == 0"
                    groups="account.group_account_user"
                >
                    <field
                        name="perf_obligation_count"
                        widget="statinfo"
                        string="Performance Obligations"
                    />
                </button>
            </xpath>
        </field>
    </record>
</odoo>
