<odoo>
    <record id="product_template_form_view" model="ir.ui.view">
        <field name="name">product.template.form.perf.obligation</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <notebook position="inside">
                <page
                    string="Revenue Recognition"
                    name="perf_obligation"
                    groups="account.group_account_user"
                >
                    <group>
                        <field name="perf_obligation_auto_create" />
                        <field
                            name="perf_obligation_recognition_method"
                            invisible="not perf_obligation_auto_create"
                            required="perf_obligation_auto_create"
                        />
                        <field
                            name="perf_obligation_months_duration"
                            invisible="perf_obligation_recognition_method != 'months'"
                            required="perf_obligation_recognition_method == 'months'"
                        />
                        <field
                            name="perf_obligation_days_duration"
                            invisible="perf_obligation_recognition_method != 'days'"
                            required="perf_obligation_recognition_method == 'days'"
                        />
                    </group>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
