<odoo>
    <record id="perf_obligation_form_inherit_sale" model="ir.ui.view">
        <field name="name">perf.obligation.form.inherit.sale</field>
        <field name="model">perf.obligation</field>
        <field name="inherit_id" ref="account_perf_obligation.perf_obligation_form" />
        <field name="arch" type="xml">
            <field name="company_id" position="after">
